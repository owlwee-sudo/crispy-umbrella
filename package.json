{
  "name": "pocket-code",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "A VS Code-style code editor for Android, built on Monaco and Capacitor.",
  "scripts": {
    "predev": "node scripts/copy-pyodide.mjs && node scripts/build-vm.mjs",
    "dev": "vite --host",
    "prebuild": "node scripts/copy-pyodide.mjs && node scripts/build-vm.mjs",
    "build": "vite build",
    "preview": "vite preview --host",
    "android:sync": "npm run build && npx cap sync android",
    "android:open": "npx cap open android",
    "android:apk": "npm run android:sync && cd android && ./gradlew assembleDebug"
  },
  "dependencies": {
    "@capacitor/android": "^8.6.0",
    "@capacitor/app": "^8.1.2",
    "@capacitor/clipboard": "^8.0.1",
    "@capacitor/core": "^8.6.0",
    "@capacitor/filesystem": "^8.1.5",
    "@capacitor/share": "^8.0.3",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/xterm": "^5.5.0",
    "jszip": "^3.10.2",
    "monaco-editor": "^0.57.0",
    "pyodide": "^314.0.7",
    "v86": "^0.5.473"
  },
  "devDependencies": {
    "@capacitor/cli": "^8.6.0",
    "vite": "^8.3.5"
  }
}
